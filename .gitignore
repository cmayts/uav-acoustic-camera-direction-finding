# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment files
.env
.env.*
!.env.example

# Credentials, keys, certificates, and local configuration
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
credentials.*
secrets.*
config.local.*

# Local audio recordings
*.wav
*.wave
*.flac
*.mp3
*.m4a

# Photos, videos, archives, and private experiment exports
*.jpg
*.jpeg
*.heic
*.mp4
*.mov
*.zip
*.7z
*.rar
*.xlsx
*.xls
*.ods

# Local data sets and generated tabular output
data/*
!data/README.md
!data/.gitkeep
*.csv
*.tsv
*.parquet
*.npy
*.npz
*.pkl
*.pickle

# Generated analysis outputs; curated examples remain tracked
results/*/
!results/examples/
!results/examples/**
